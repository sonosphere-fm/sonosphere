# Which copy of the site is live. deploy.sh rewrites this one line and reloads nginx to switch over.
include /etc/nginx/spin-upstream.conf;

# The site sits behind Cloudflare. Only Cloudflare's addresses (https://www.cloudflare.com/ips) may connect; the
# visitor's own address comes from CF-Connecting-IP, which is trusted only on those connections.
geo $realip_remote_addr $via_cloudflare {
  default 0;
  127.0.0.1/32 1; ::1/128 1;
  173.245.48.0/20 1; 103.21.244.0/22 1; 103.22.200.0/22 1; 103.31.4.0/22 1; 141.101.64.0/18 1; 108.162.192.0/18 1;
  190.93.240.0/20 1; 188.114.96.0/20 1; 197.234.240.0/22 1; 198.41.128.0/17 1; 162.158.0.0/15 1; 104.16.0.0/13 1;
  104.24.0.0/14 1; 172.64.0.0/13 1; 131.0.72.0/22 1;
  2400:cb00::/32 1; 2606:4700::/32 1; 2803:f800::/32 1; 2405:b500::/32 1; 2405:8100::/32 1; 2a06:98c0::/29 1; 2c0f:f248::/32 1;
}
set_real_ip_from 173.245.48.0/20; set_real_ip_from 103.21.244.0/22; set_real_ip_from 103.22.200.0/22;
set_real_ip_from 103.31.4.0/22; set_real_ip_from 141.101.64.0/18; set_real_ip_from 108.162.192.0/18;
set_real_ip_from 190.93.240.0/20; set_real_ip_from 188.114.96.0/20; set_real_ip_from 197.234.240.0/22;
set_real_ip_from 198.41.128.0/17; set_real_ip_from 162.158.0.0/15; set_real_ip_from 104.16.0.0/13;
set_real_ip_from 104.24.0.0/14; set_real_ip_from 172.64.0.0/13; set_real_ip_from 131.0.72.0/22;
set_real_ip_from 2400:cb00::/32; set_real_ip_from 2606:4700::/32; set_real_ip_from 2803:f800::/32;
set_real_ip_from 2405:b500::/32; set_real_ip_from 2405:8100::/32; set_real_ip_from 2a06:98c0::/29;
set_real_ip_from 2c0f:f248::/32;
real_ip_header CF-Connecting-IP;

# Cloudflare says whether the visitor used https; a direct local request counts as https.
map $http_x_forwarded_proto $visitor_proto { default https; http http; }

server {
  listen 80 default_server;
  listen [::]:80 default_server;
  # Cloudflare's "Full" mode connects over https. The certificate is self-signed (made by remote.sh) unless a
  # Cloudflare origin certificate has been put in its place.
  listen 443 ssl default_server;
  listen [::]:443 ssl default_server;
  ssl_certificate /etc/nginx/spin-origin.crt;
  ssl_certificate_key /etc/nginx/spin-origin.key;
  http2 on;
  # Cloudflare's edge can be an ocean away, so every fresh connection costs several round trips. Let it resume TLS
  # sessions and keep idle connections open as long as it does (about 15 minutes) instead of nginx's default 65s.
  ssl_session_cache shared:spin_tls:10m;
  ssl_session_timeout 1d;
  keepalive_timeout 900s;
  keepalive_requests 100000;

  if ($via_cloudflare = 0) { return 444; }
  if ($visitor_proto = http) { return 301 https://$host$request_uri; }

  client_max_body_size 300m;
  gzip on; gzip_proxied any; gzip_comp_level 6; gzip_min_length 512; gzip_vary on;
  gzip_types text/css application/javascript text/javascript application/json image/svg+xml text/plain application/xml;
  location = /api/ws {
    proxy_pass http://spin;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $visitor_proto;
    proxy_read_timeout 3600s; proxy_send_timeout 3600s;
  }
  location / {
    proxy_pass http://spin;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $visitor_proto;
    proxy_read_timeout 300s; proxy_send_timeout 300s;
  }
}
