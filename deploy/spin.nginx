# Which copy of the site is live. deploy.sh rewrites this one line and reloads nginx to switch over.
include /etc/nginx/spin-upstream.conf;
server {
  listen 80 default_server;
  client_max_body_size 300m;
  gzip on; gzip_proxied any; gzip_comp_level 6; gzip_min_length 512; gzip_vary on;
  gzip_types text/css application/javascript text/javascript application/json image/svg+xml text/plain application/xml;
  location = /api/ws {
    proxy_pass http://spin;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_read_timeout 3600s; proxy_send_timeout 3600s;
  }
  location / {
    proxy_pass http://spin;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_read_timeout 300s; proxy_send_timeout 300s;
  }
}
