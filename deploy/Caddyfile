{
	auto_https disable_redirects
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
		timeouts {
			idle 15m
		}
	}
}

(cloudflare) {
	# Only Cloudflare may connect (https://www.cloudflare.com/ips)
	@direct not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32 127.0.0.1/8 ::1
	abort @direct
}

(site) {
	import cloudflare

	@plain header X-Forwarded-Proto http
	redir @plain https://{host}{uri} 301

	request_body {
		max_size 300MB
	}
	encode zstd gzip
	import app
}

(app) {
	reverse_proxy 127.0.0.1:3000 {
		header_up X-Forwarded-For {client_ip}
		header_up X-Forwarded-Proto https
		# holds requests while the app restarts during a deploy
		lb_try_duration 30s
		lb_try_interval 250ms
	}
}

# Cloudflare "Full" mode accepts Caddy's self-signed certificate
https://sonosphere.fm {
	tls internal
	import site
}

# short links: sonosp.here/<username> and sonosp.here/<a|r|t>/<id>
https://sonosp.here {
	tls internal
	import cloudflare
	handle / {
		redir https://sonosphere.fm/ 302
	}
	# scrobblers set up during the beta still post here
	@compat path /2.0 /2.0/*
	handle @compat {
		import app
	}
	handle {
		rewrite * /api/short{path}
		import app
	}
}

# Plausible CE, run from /opt/plausible
https://plausible.sonosphere.fm {
	tls internal
	import cloudflare
	encode zstd gzip
	reverse_proxy 127.0.0.1:8000 {
		header_up X-Forwarded-For {client_ip}
	}
}

https://www.sonosphere.fm {
	tls internal
	import cloudflare
	redir https://sonosphere.fm{uri} 301
}

http:// {
	import site
}
