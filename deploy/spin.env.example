# /opt/spin/spin.env on the server. Read by the app container (compose.yaml).
# Docker passes values through as-is, so don't quote them.

DATABASE_URL=postgres://spin:PASSWORD@127.0.0.1/sonosphere
DB_POOL=
VALKEY_URL=redis://127.0.0.1:6379
SITE_URL=https://example.com
TRUSTED_ORIGINS=
ADMIN_USERS=

# Pictures. Without S3_BUCKET they're kept in DATA_DIR/media (development only).
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
STORAGE_USER_MB=
STORAGE_MAX_MB=
STORAGE_DAILY_WRITES=
STORAGE_DAILY_READS=

# Spotify: each listener brings their own app; the site only needs the https callback address.
SPOTIFY_REDIRECT_URI=https://example.com/api/spotify/callback
SPOTIFY_TOKEN_KEY=
# 1 to also look up catalogue details through listeners' Spotify apps (plays are always imported)
SPOTIFY_API=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
MBDB_URL=
TICKETMASTER_KEY=
YOUTUBE_API_KEY=

# Without SMTP settings, mail is written to DATA_DIR/mail as .eml files.
MAIL_FROM=Sonosphere <hello@example.com>
SMTP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_DAILY_LIMIT=
