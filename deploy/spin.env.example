# Copy to /opt/spin/spin.env on the server, fill in, then deploy (each deploy starts fresh processes that read it).

# The Postgres database. Each site process keeps up to DB_POOL connections (default 10).
DATABASE_URL=postgres://spin:PASSWORD@127.0.0.1/sonosphere
DB_POOL=

# Valkey (or Redis): rate limits, shared caches, job locks and live updates across the site's processes. Without it
# each process keeps these to itself, which is only right when there is a single process.
VALKEY_URL=redis://127.0.0.1:6379
# How many site processes each release runs (deploy/remote.sh). Default: half the CPU cores.
INSTANCES=

# Where uploaded pictures are kept: any S3-compatible bucket (Amazon S3, Cloudflare R2, Backblaze B2, MinIO...).
# The bucket should be private; browsers get signed links that last a few days. Without S3_BUCKET pictures are kept
# in a folder next to the database (DATA_DIR/media), which is meant for development.
# For R2: S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com, S3_REGION=auto, and an R2 API token's access key
# id and secret (for a Cloudflare API token: its id, and the SHA-256 of the token in hex).
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Limits on storage use (server/storage/budget.ts). Per person, default 25 MB; the rest are off unless set: total
# space for the site, writes and deletes per day (R2 class A), picture links handed out per day (about one read each).
STORAGE_USER_MB=
STORAGE_MAX_MB=
STORAGE_DAILY_WRITES=
STORAGE_DAILY_READS=
# Uploads are decoded in a throwaway sandboxed systemd unit when the site runs as root on Linux; "off" skips that.
IMAGE_SANDBOX=

# Spotify scrobbling. Each listener connects through their own Spotify app (settings walks them through making
# one), so the site needs no Spotify credentials, only the address Spotify returns to. Spotify accepts only https
# (or a loopback address), so this is either
#   https://your-domain/api/spotify/callback          once the site has a domain with https, or
#   https://<proxy>.workers.dev/api/spotify/callback   a Cloudflare Worker in front of the site
# Without it the site's own address is used when that is https; on plain http Spotify shows as disabled.
SPOTIFY_REDIRECT_URI=
# Optional: key for encrypting stored Spotify tokens. Without it a random key file is kept next to the database.
SPOTIFY_TOKEN_KEY=

# Other addresses the site is served from (comma separated), e.g. a proxy worker in front of it. Forms and
# buttons used through them are refused as cross-site without this.
TRUSTED_ORIGINS=

# Cloudflare Turnstile on sign-up and log-in (both or neither; off when unset)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Mail (sign-up confirmation, welcome, password resets, email changes). Without SMTP settings, mail is written to
# DATA_DIR/mail as .eml files instead of being sent. SITE_URL is where links in mail point.
SITE_URL=https://example.com
MAIL_FROM=Sonosphere <hello@example.com>
SMTP_URL=
# or in parts: SMTP_HOST=  SMTP_PORT=587  SMTP_USER=  SMTP_PASS=  SMTP_SECURE=false
# optional cap on messages per day, to stay inside a provider's plan
MAIL_DAILY_LIMIT=
