# Copy to /opt/spin/spin.env on the server, fill in, then deploy (each deploy starts fresh processes that read it).

# The Postgres database. Each site process keeps up to DB_POOL connections (default 10).
DATABASE_URL=postgres://spin:PASSWORD@127.0.0.1/sonosphere
DB_POOL=

# Valkey (or Redis): rate limits, shared caches, job locks and live updates across the site's processes. Without it
# each process keeps these to itself, which is only right when there is a single process.
VALKEY_URL=redis://127.0.0.1:6379
# How many site processes each release runs (deploy/remote.sh). Default: half the CPU cores.
INSTANCES=

# Spotify scrobbling. Each listener connects through their own Spotify app (settings walks them through making
# one), so the site needs no Spotify credentials, only the address Spotify returns to. Spotify accepts only https
# (or a loopback address), so this is either
#   https://your-domain/api/spotify/callback          once the site has a domain with https, or
#   https://<proxy>.workers.dev/api/spotify/callback   a Cloudflare Worker in front of the site
# Without it the site's own address is used when that is https; on plain http Spotify shows as disabled.
SPOTIFY_REDIRECT_URI=
# Optional: key for encrypting stored Spotify tokens. Without it a random key file is kept next to the database.
SPOTIFY_TOKEN_KEY=

# Other addresses the site is served from (comma separated), e.g. a proxy worker in front of it. Forms and
# buttons used through them are refused as cross-site without this.
TRUSTED_ORIGINS=
