[Unit]
Description=Sonosphere (port %i)
After=network.target postgresql.service valkey-server.service
Wants=postgresql.service valkey-server.service
[Service]
WorkingDirectory=/opt/spin/slot/%i
Environment=NODE_ENV=production PORT=%i DATA_DIR=/opt/spin/data
# DATABASE_URL, VALKEY_URL and site settings live here (optional; see deploy/spin.env.example)
EnvironmentFile=-/opt/spin/spin.env
ExecStart=/usr/local/bin/bun server/index.ts
Restart=always
# on stop the site finishes the requests it is serving before it exits
KillSignal=SIGTERM
TimeoutStopSec=20
[Install]
WantedBy=multi-user.target
