{
  "name": "sonosphere",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot server/index.ts",
    "start": "NODE_ENV=production bun server/index.ts",
    "import:dev": "bun server/dev/import.ts",
    "reset": "dropdb --if-exists --force sonosphere && createdb sonosphere && rm -f data/dev-login.txt",
    "db:generate": "drizzle-kit generate",
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@astryxdesign/core": "^0.7.16",
    "@astryxdesign/theme-neutral": "^0.7.16",
    "@fontsource-variable/radio-canada": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@phosphor-icons/react": "^2.1.10",
    "@stylexjs/stylex": "^0.19.2",
    "@uimaxbai/am-lyrics": "^1.9.2",
    "country-flag-icons": "^1.6.20",
    "drizzle-orm": "^0.45.4",
    "nodemailer": "^10.6.1",
    "postgres": "^4.1.1",
    "react": "19",
    "react-dom": "19",
    "react-router-dom": "6"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.16",
    "@types/bun": "^1.4.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19",
    "@types/react-dom": "19",
    "cheerio": "^1.2.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  }
}
